{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist-main",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/electron", "src/shared"]
}
